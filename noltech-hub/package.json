{
  "name": "noltech-hub",
  "productName": "NolTech Hub",
  "description": "Electronics resale operations hub \u2014 inventory, listings, bookkeeping, and lot analysis",
  "author": "",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test:build": "vite build && node scripts/check-build.cjs",
    "test:health": "node scripts/health-check.cjs",
    "electron": "electron .",
    "electron:dev": "concurrently -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron .",
    "icon": "node scripts/generate-icon.cjs",
    "package": "vite build && electron-packager . \"NolTech Hub\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/release\" --ignore=\"^\\.git\" --ignore=\"^/src\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.103.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "to-ico": "^1.1.5",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "license": "MIT"
}
