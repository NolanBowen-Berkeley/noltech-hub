# ─── NolTech Hub (renderer) ──────────────────────────────────────────────────
# Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# WARNING: Vite inlines every VITE_* variable into the built bundle. Anything
# here ends up readable in dist/. Only put values here that are safe to
# publish — never a service-role key, never an API secret. Server-side
# credentials belong in noltech-pipeline/.env, which is never bundled.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API.
#
# The anon key is public by design — it's shipped to every client. It is only
# safe because row-level security decides what it can reach. Apply the
# migrations in supabase/migrations/ before pointing this at real data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Local pipeline ──────────────────────────────────────────────────────────
# Not configured here. The Hub starts noltech-pipeline automatically on
# http://localhost:3001; to point it elsewhere (a Pi on the LAN, a different
# port) use the in-app Settings → Local Pipeline form, which also stores the
# bearer token encrypted rather than in plaintext on disk.
