# ═════════════════════════════════════════════════════════════════════════════
# NolTech Sync Agent — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ═════════════════════════════════════════════════════════════════════════════

# ---- Supabase --------------------------------------------------------------
# Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key. BYPASSES ROW LEVEL SECURITY — treat like a root password.
# NEVER commit this anywhere, NEVER expose to a browser/desktop client.
# Only this agent and other trusted server-side processes should hold it.
SUPABASE_SERVICE_KEY=your-service-role-key

# UUID of the workspace this agent syncs. One agent instance, one workspace.
WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ---- eBay credentials ------------------------------------------------------
# Auth'n'Auth user token used by the legacy Trading API (GetMyeBaySelling,
# GetSellerList, etc.). Long-lived; rotate via the eBay developer portal.
EBAY_USER_TOKEN=

# OAuth2 refresh token for the modern Sell APIs (Fulfillment, Finances).
# The agent exchanges this for short-lived access tokens at runtime.
EBAY_REFRESH_TOKEN=

# eBay app keyset from https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# ---- Pipeline --------------------------------------------------------------
# Base URL of the noltech-pipeline service (lots, manifests, closing prices).
# Same host by default; point elsewhere if it runs on another box.
PIPELINE_URL=http://localhost:3001

# Bearer token for the pipeline. Leave BLANK when it binds loopback only —
# that's the default and it runs without auth. Must match the pipeline's
# SHARED_AUTH_SECRET whenever that is set, or every call returns 401.
PIPELINE_AUTH_SECRET=

# ---- Logging ---------------------------------------------------------------
LOG_DIR=./logs

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Heartbeat identity ----------------------------------------------------
# Stable ID for this agent — primary key in the agent_heartbeats table.
# Use something like `pi-home`, `pi-warehouse`, `staging-vm`.
HEARTBEAT_AGENT_ID=agent-1

# Optional override; defaults to os.hostname() if blank.
HEARTBEAT_HOSTNAME=

# ---- Cron schedules (standard 5-field cron syntax) -------------------------
# Listings sync — hourly on the hour.
CRON_LISTINGS=0 * * * *

# Orders + finances sync — every 15 minutes.
CRON_ORDERS=*/15 * * * *

# Heartbeat ping — every minute. Keeps the dashboard "online" indicator green.
CRON_HEARTBEAT=* * * * *

# Sold-comps cache pre-warmer — every 30 minutes.
CRON_SOLD_COMPS_WARMER=*/30 * * * *

# Browse-lots refresh — every 2 hours at :30 so it offsets the others.
CRON_BROWSE_LOTS_REFRESH=30 */2 * * *
DISABLE_BROWSE_LOTS_REFRESH=

# Manifest pricer — every 2 hours, offset by 15 min so it doesn't collide with
# the on-the-hour listings sync.
CRON_MANIFEST_PRICER=15 */2 * * *

# ---- Sold-comps pre-warming (optional) -------------------------------------
# Leave empty to disable. When set, the agent pre-warms the sold-comps cache
# for each new item processed during a sync run.
SOLD_COMPS_LAMBDA_URL=
SOLD_COMPS_AUTH_SECRET=
SOLD_COMPS_PREWARM_LIMIT=20

# ---- Manifest pricer (optional) --------------------------------------------
# Cap on lots processed per cron run. The next run picks up where this left
# off, so a higher cap means faster coverage at higher cost per tick.
MANIFEST_PRICER_MAX_LOTS_PER_RUN=20

# Set to 1 to skip scheduling the manifest pricer cron entirely.
DISABLE_MANIFEST_PRICER=
