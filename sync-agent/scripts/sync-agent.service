[Unit]
Description=NolTech Sync Agent (eBay → Supabase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=10s
StandardOutput=append:__INSTALL_DIR__/logs/stdout.log
StandardError=append:__INSTALL_DIR__/logs/stderr.log
EnvironmentFile=__INSTALL_DIR__/.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__INSTALL_DIR__/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
