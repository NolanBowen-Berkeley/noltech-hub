# ─── noltech-pipeline ────────────────────────────────────────────────────────
# Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Everything is optional. The service boots with none of this set — the sample
# providers need no credentials — and warns at startup about which features are
# dark. See README.md for what degrades.

# ─── Server ──────────────────────────────────────────────────────────────────
PIPELINE_PORT=3001

# Loopback only by default. Change to 0.0.0.0 to serve other machines on your
# LAN (e.g. the Hub on a laptop, the service on a Pi) — and if you do, SET
# SHARED_AUTH_SECRET BELOW. The lot routes will spend whatever your configured
# provider costs on behalf of anyone who can reach the port.
PIPELINE_BIND_HOST=127.0.0.1

# Where the disk-backed caches live. Defaults to <pipeline>/.data
# PIPELINE_DATA_DIR=

# Bearer token clients must send. Leave EMPTY for a loopback-only desktop
# install. REQUIRED if PIPELINE_BIND_HOST is not loopback.
SHARED_AUTH_SECRET=

# ─── Data providers ──────────────────────────────────────────────────────────
# Where lots and prices come from. See docs/DATA-SOURCES.md.
#
# LOT_PROVIDER    sample | custom
# COMPS_PROVIDER  sample | ebay-browse | custom
#
# 'sample' generates plausible data offline so a fresh clone runs end to end.
# It tells you NOTHING TRUE about the market — responses are flagged
# `sample: true` and the sync agent refuses to persist them. Point these at a
# real source before trusting any number this service produces.
LOT_PROVIDER=sample
COMPS_PROVIDER=sample

# Lot source IDs to fan out over, comma-separated. Meaningful to your provider.
LOT_SOURCES=sample

# For LOT_PROVIDER=custom / COMPS_PROVIDER=custom — an npm package name or an
# absolute path (a file: URL on Windows) exporting `lotProvider` / `compsProvider`.
# LOT_PROVIDER_MODULE=
# COMPS_PROVIDER_MODULE=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Needed by the discovery/analysis/refresh/alerts/ebay-sync crons. The HTTP lot
# routes work without it. Dashboard → Project Settings → API.
#
# SERVICE KEY BYPASSES ROW LEVEL SECURITY. Treat it like a root password:
# server-side only, never in the Hub, never in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ─── eBay ────────────────────────────────────────────────────────────────────
# App keyset from https://developer.ebay.com/my/keys
# Required for COMPS_PROVIDER=ebay-browse and for the ebay-sync cron.
# The refresh token starts `v^1.1#i^1#...`
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=

# ─── AI part-out (optional) ──────────────────────────────────────────────────
# Either key is sufficient. Without one, part-out estimates are unavailable.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Cron schedules ──────────────────────────────────────────────────────────
# Standard 5-field cron. Set any to `off` to disable that job, or set
# CRONS_ENABLED=false to disable all of them and serve HTTP only.
CRONS_ENABLED=false
CRON_ANALYSIS=*/5 * * * *
CRON_ALERTS=*/5 * * * *
CRON_REFRESH=*/15 * * * *
CRON_DISCOVERY=*/30 * * * *
CRON_EBAY_SYNC=*/30 * * * *

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Sold-comps pricing
SOLD_COMPS_DAYS=90
SOLD_COMPS_MAX_RESULTS=60
SOLD_COMPS_EMPTY_TTL_HRS=6
SOLD_COMPS_FULL_TTL_DAYS=14

# Per-lot analysis
ANALYSIS_PER_LOT_CONCURRENCY=20
ANALYSIS_MAX_PRICED_ITEMS=40
ANALYSIS_LOTS_PER_TICK=0
ANALYSIS_DAILY_COST_CAP_USD=0

# Discovery
DISCOVERY_MAX_LOTS_PER_TICK=30
DISCOVERY_BID_CEILING_RATIO=0.8

# Cache TTLs (seconds)
CACHE_TTL_SEARCH=600
CACHE_TTL_MANIFEST=86400
CACHE_TTL_IMAGE=604800

# ─── Alerts / logging ────────────────────────────────────────────────────────
# Base URL used to build proxied image links in Discord/ntfy alerts. Must be
# reachable by whatever renders the alert — localhost works for desktop
# notifications only.
PUBLIC_BASE_URL=http://localhost:3001

CRON_LOG_LEVEL=info

# Optional structured log shipping.
LOGFLARE_SOURCE_TOKEN=
LOGFLARE_API_KEY=
